# ==============================================================================
# SaniPay - Platform Environment Configuration Template (.env.example)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & RUNTIME ENVIRONMENT
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
APP_NAME=SaniPay
APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 2. DATABASE & ORM (PostgreSQL & Prisma)
# ------------------------------------------------------------------------------
POSTGRES_USER=sanipay_user
POSTGRES_PASSWORD=sanipay_password_secure_local
POSTGRES_DB=sanipay_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://sanipay_user:sanipay_password_secure_local@localhost:5432/sanipay_db?schema=public

# ------------------------------------------------------------------------------
# 3. CACHING & BACKGROUND JOB QUEUE (Redis & BullMQ)
# ------------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ------------------------------------------------------------------------------
# 4. AUTHENTICATION & SECURITY (Argon2id + JWT + Refresh Tokens)
# ------------------------------------------------------------------------------
# Generate cryptographic keys using: openssl rand -base64 48
JWT_ACCESS_SECRET=your_super_secret_jwt_access_key_min_32_chars_long
JWT_REFRESH_SECRET=your_super_secret_jwt_refresh_key_min_32_chars_long
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d
ENCRYPTION_KEY=32_bytes_random_hex_for_provider_secrets_storage

# ------------------------------------------------------------------------------
# 5. TELECOM & VTU PROVIDERS (VTPass & ClubKonnect)
# ------------------------------------------------------------------------------
# Active provider: 'vtpass' | 'clubkonnect' | 'mock'
DEFAULT_VTU_PROVIDER=mock

# VTPass API Configuration
VTPASS_BASE_URL=https://api-service.vtpass.com/api
VTPASS_API_KEY=your_vtpass_api_key
VTPASS_SECRET_KEY=your_vtpass_secret_key
VTPASS_PUBLIC_KEY=your_vtpass_public_key

# ClubKonnect API Configuration
CLUBKONNECT_BASE_URL=https://www.clubkonnect.com/API
CLUBKONNECT_USER_ID=your_clubkonnect_user_id
CLUBKONNECT_API_KEY=your_clubkonnect_api_key

# ------------------------------------------------------------------------------
# 6. PAYMENT GATEWAYS (Flutterwave)
# ------------------------------------------------------------------------------
# Active gateway: 'flutterwave' | 'mock'
DEFAULT_PAYMENT_GATEWAY=mock

# Flutterwave v3 API Configuration
FLUTTERWAVE_BASE_URL=https://api.flutterwave.com/v3
FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_TEST-your_flutterwave_public_key
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-your_flutterwave_secret_key
FLUTTERWAVE_ENCRYPTION_KEY=FLWSECK_TEST_encryption_key
FLUTTERWAVE_WEBHOOK_SECRET=your_custom_webhook_secret_hash

# ------------------------------------------------------------------------------
# 7. BUSINESS LOGIC & REFERRAL SYSTEM
# ------------------------------------------------------------------------------
# All monetary figures stored as integer Kobo (1 NGN = 100 Kobo)
REFERRAL_BONUS_KOBO=5000                   # ₦50.00
REFERRAL_QUALIFY_MIN_FUNDING_KOBO=100000   # ₦1,000.00
DEFAULT_AIRTIME_DISCOUNT_BPS=250           # 2.50% discount

# ------------------------------------------------------------------------------
# 8. ADMIN DASHBOARD CONFIGURATION (Next.js)
# ------------------------------------------------------------------------------
ADMIN_PORT=3001
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1
NEXT_TELEMETRY_DISABLED=1
