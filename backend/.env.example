# Server Environment
NODE_ENV=development
PORT=3000
APP_NAME=SaniPay
API_PREFIX=api/v1

# Primary Database (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://sanipay_user:sanipay_password@localhost:5432/sanipay_db?schema=public"

# Redis & Queues
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Secrets & Expiry
JWT_ACCESS_SECRET=your-super-secret-access-key-minimum-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your-super-secret-refresh-key-minimum-32-chars
JWT_REFRESH_EXPIRES_IN=30d

# Payment Gateways (Configurable - Server Only)
DEFAULT_PAYMENT_GATEWAY=mock # mock | paystack | flutterwave
PAYSTACK_SECRET_KEY=sk_test_...
PAYSTACK_PUBLIC_KEY=pk_test_...
PAYSTACK_WEBHOOK_SECRET=whsec_...

FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-...
FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_TEST-...
FLUTTERWAVE_ENCRYPTION_KEY=FLWSECK_TEST_ENC-...
FLUTTERWAVE_WEBHOOK_SECRET=...

# VTU Aggregators (Configurable - Server Only)
DEFAULT_VTU_PROVIDER=mock # mock | vtpass | clubkonnect
VTPASS_API_KEY=
VTPASS_SECRET_KEY=
VTPASS_BASE_URL=https://sandbox.vtpass.com/api

CLUBKONNEKT_API_KEY=
CLUBKONNEKT_USER_ID=
CLUBKONNEKT_BASE_URL=https://www.clubkonnect.com/api

# SMS / OTP Providers (Server Only)
SMS_PROVIDER=mock # mock | termii | sendchamp
TERMII_API_KEY=
TERMII_SENDER_ID=SaniPay

# Push Notifications (Firebase)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
