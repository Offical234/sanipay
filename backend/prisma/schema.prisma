// SaniPay Production Database Schema
// Database Engine: PostgreSQL
// ORM: Prisma ORM

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -------------------------------------------------------------
// ENUMS
// -------------------------------------------------------------

enum UserRole {
  CUSTOMER
  AGENT
  SUPPORT
  FINANCE_ADMIN
  SUPER_ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  PENDING_VERIFICATION
}

enum TransactionType {
  AIRTIME
  DATA
  ELECTRICITY
  CABLE_TV
  WALLET_FUNDING
  WALLET_TRANSFER
  REFERRAL_BONUS
  REFUND
}

enum TransactionStatus {
  PENDING
  PROCESSING
  SUCCESS
  FAILED
  REFUNDED
}

enum LedgerEntryType {
  CREDIT
  DEBIT
}

enum PaymentGateway {
  PAYSTACK
  FLUTTERWAVE
  MONNIFY
  MOCK
}

enum TelecomNetworkCode {
  MTN
  AIRTEL
  GLO
  NINE_MOBILE
}

enum DataPlanType {
  SME
  CORPORATE_GIFTING
  DIRECT_GIFTING
  REGULAR
}

enum MeterType {
  PREPAID
  POSTPAID
}

enum ReferralStatus {
  PENDING_QUALIFICATION
  QUALIFIED
  REWARDED
}

enum NotificationType {
  TRANSACTION
  WALLET
  PROMOTION
  SECURITY
  SYSTEM
}

enum TicketCategory {
  AIRTIME
  DATA
  ELECTRICITY
  CABLE_TV
  WALLET
  GENERAL
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum SenderType {
  USER
  ADMIN
}

enum RefundStatus {
  PENDING
  COMPLETED
  REJECTED
}

enum ActorType {
  USER
  ADMIN
  SYSTEM
}

// -------------------------------------------------------------
// USER & IDENTITY MODELS
// -------------------------------------------------------------

model User {
  id                  String     @id @default(uuid()) @db.Uuid
  email               String     @unique @db.VarChar(255)
  phone               String     @unique @db.VarChar(20)
  passwordHash        String     @map("password_hash") @db.VarChar(255)
  transactionPinHash  String     @map("transaction_pin_hash") @db.VarChar(255)
  role                UserRole   @default(CUSTOMER)
  status              UserStatus @default(ACTIVE)
  isEmailVerified     Boolean    @default(false) @map("is_email_verified")
  isPhoneVerified     Boolean    @default(false) @map("is_phone_verified")
  referralCode        String     @unique @map("referral_code") @db.VarChar(20)
  referredById        String?    @map("referred_by_id") @db.Uuid
  failedLoginAttempts Int        @default(0) @map("failed_login_attempts")
  lockoutUntil        DateTime?  @map("lockout_until")
  lastLoginAt         DateTime?  @map("last_login_at")
  createdAt           DateTime   @default(now()) @map("created_at")
  updatedAt           DateTime   @updatedAt @map("updated_at")

  // Relations
  referredBy          User?                @relation("UserReferrals", fields: [referredById], references: [id])
  referralsMade       User[]               @relation("UserReferrals")
  profile             UserProfile?
  wallet              Wallet?
  transactions        Transaction[]
  paymentTransactions PaymentTransaction[]
  referralRecords     Referral[]           @relation("ReferrerRelation")
  referredRecord      Referral?            @relation("ReferredUserRelation")
  referralRewards     ReferralReward[]
  notifications       Notification[]
  supportTickets      SupportTicket[]
  refunds             Refund[]
  refreshTokens       RefreshToken[]

  @@index([email])
  @@index([phone])
  @@index([referralCode])
  @@map("users")
}

model UserProfile {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @unique @map("user_id") @db.Uuid
  fullName    String   @map("full_name") @db.VarChar(255)
  avatarUrl   String?  @map("avatar_url") @db.VarChar(512)
  bvnVerified Boolean  @default(false) @map("bvn_verified")
  ninVerified Boolean  @default(false) @map("nin_verified")
  address     String?  @db.Text
  state       String?  @db.VarChar(100)
  lga         String?  @db.VarChar(100)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

model RefreshToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @unique @map("token_hash") @db.VarChar(255)
  isRevoked Boolean  @default(false) @map("is_revoked")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("refresh_tokens")
}

// -------------------------------------------------------------
// FINANCIAL WALLET & DOUBLE-ENTRY LEDGER MODELS
// (ALL AMOUNTS IN KOBO - NO FLOATING POINT VALUES)
// -------------------------------------------------------------

model Wallet {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @unique @map("user_id") @db.Uuid
  balanceKobo       BigInt   @default(0) @map("balance_kobo")
  ledgerBalanceKobo BigInt   @default(0) @map("ledger_balance_kobo")
  currency          String   @default("NGN") @db.VarChar(3)
  isLocked          Boolean  @default(false) @map("is_locked")
  lockReason        String?  @map("lock_reason") @db.VarChar(255)
  version           Int      @default(0)
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  user               User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  walletTransactions WalletTransaction[]

  @@map("wallets")
}

model WalletTransaction {
  id                String          @id @default(uuid()) @db.Uuid
  walletId          String          @map("wallet_id") @db.Uuid
  transactionId     String          @map("transaction_id") @db.Uuid
  type              LedgerEntryType
  amountKobo        BigInt          @map("amount_kobo")
  balanceBeforeKobo BigInt          @map("balance_before_kobo")
  balanceAfterKobo  BigInt          @map("balance_after_kobo")
  description       String          @db.VarChar(255)
  createdAt         DateTime        @default(now()) @map("created_at")

  wallet      Wallet      @relation(fields: [walletId], references: [id], onDelete: Restrict)
  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Restrict)

  @@index([walletId, createdAt])
  @@index([transactionId])
  @@map("wallet_transactions")
}

// -------------------------------------------------------------
// TRANSACTION CORE & SUB-SERVICES
// -------------------------------------------------------------

model Transaction {
  id                String            @id @default(uuid()) @db.Uuid
  userId            String            @map("user_id") @db.Uuid
  reference         String            @unique @db.VarChar(64)
  idempotencyKey    String            @unique @map("idempotency_key") @db.VarChar(64)
  type              TransactionType
  status            TransactionStatus @default(PENDING)
  amountKobo        BigInt            @map("amount_kobo")
  feeKobo           BigInt            @default(0) @map("fee_kobo")
  discountKobo      BigInt            @default(0) @map("discount_kobo")
  netAmountKobo     BigInt            @map("net_amount_kobo")
  currency          String            @default("NGN") @db.VarChar(3)
  providerName      String?           @map("provider_name") @db.VarChar(50)
  providerReference String?           @map("provider_reference") @db.VarChar(128)
  failureReason     String?           @map("failure_reason") @db.Text
  metadata          Json?
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  user                   User                    @relation(fields: [userId], references: [id], onDelete: Restrict)
  walletTransactions     WalletTransaction[]
  transactionItems       TransactionItem[]
  paymentTransaction     PaymentTransaction?
  airtimeTransaction     AirtimeTransaction?
  dataTransaction        DataTransaction?
  electricityTransaction ElectricityTransaction?
  cableTransaction       CableTransaction?
  refund                 Refund?
  supportTickets         SupportTicket[]
  providerLogs           ProviderTransaction[]
  referralRewards        ReferralReward[]

  @@index([userId, createdAt])
  @@index([status])
  @@index([type])
  @@index([reference])
  @@index([providerReference])
  @@map("transactions")
}

model TransactionItem {
  id            String @id @default(uuid()) @db.Uuid
  transactionId String @map("transaction_id") @db.Uuid
  itemName      String @map("item_name") @db.VarChar(255)
  itemType      String @map("item_type") @db.VarChar(50)
  unitPriceKobo BigInt @map("unit_price_kobo")
  quantity      Int    @default(1)
  totalKobo     BigInt @map("total_kobo")

  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@index([transactionId])
  @@map("transaction_items")
}

model PaymentTransaction {
  id                String            @id @default(uuid()) @db.Uuid
  transactionId     String            @unique @map("transaction_id") @db.Uuid
  userId            String            @map("user_id") @db.Uuid
  gateway           PaymentGateway
  gatewayReference  String            @unique @map("gateway_reference") @db.VarChar(128)
  gatewaySessionId  String?           @map("gateway_session_id") @db.VarChar(255)
  amountKobo        BigInt            @map("amount_kobo")
  gatewayFeeKobo    BigInt            @default(0) @map("gateway_fee_kobo")
  channel           String?           @db.VarChar(50)
  status            TransactionStatus @default(PENDING)
  paidAt            DateTime?         @map("paid_at")
  rawWebhookPayload Json?             @map("raw_webhook_payload")
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  user        User        @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([gatewayReference])
  @@index([userId])
  @@map("payment_transactions")
}

// -------------------------------------------------------------
// VTU SPECIFIC TRANSACTIONS
// -------------------------------------------------------------

model AirtimeTransaction {
  id             String   @id @default(uuid()) @db.Uuid
  transactionId  String   @unique @map("transaction_id") @db.Uuid
  networkId      String   @map("network_id") @db.Uuid
  recipientPhone String   @map("recipient_phone") @db.VarChar(20)
  amountKobo     BigInt   @map("amount_kobo")
  discountKobo   BigInt   @default(0) @map("discount_kobo")
  providerStatus String?  @map("provider_status") @db.VarChar(50)
  createdAt      DateTime @default(now()) @map("created_at")

  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  network     Network     @relation(fields: [networkId], references: [id], onDelete: Restrict)

  @@index([recipientPhone])
  @@map("airtime_transactions")
}

model DataTransaction {
  id             String   @id @default(uuid()) @db.Uuid
  transactionId  String   @unique @map("transaction_id") @db.Uuid
  networkId      String   @map("network_id") @db.Uuid
  planId         String   @map("plan_id") @db.Uuid
  recipientPhone String   @map("recipient_phone") @db.VarChar(20)
  amountKobo     BigInt   @map("amount_kobo")
  planName       String   @map("plan_name") @db.VarChar(100)
  dataVolume     String   @map("data_volume") @db.VarChar(50)
  createdAt      DateTime @default(now()) @map("created_at")

  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  network     Network     @relation(fields: [networkId], references: [id], onDelete: Restrict)
  plan        DataPlan    @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@index([recipientPhone])
  @@map("data_transactions")
}

model ElectricityTransaction {
  id              String    @id @default(uuid()) @db.Uuid
  transactionId   String    @unique @map("transaction_id") @db.Uuid
  providerId      String    @map("provider_id") @db.Uuid
  meterNumber     String    @map("meter_number") @db.VarChar(50)
  meterType       MeterType @map("meter_type")
  customerName    String    @map("customer_name") @db.VarChar(255)
  customerAddress String?   @map("customer_address") @db.Text
  amountKobo      BigInt    @map("amount_kobo")
  token           String?   @db.VarChar(100)
  units           String?   @db.VarChar(50)
  receiptNumber   String?   @map("receipt_number") @db.VarChar(100)
  createdAt       DateTime  @default(now()) @map("created_at")

  transaction Transaction         @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  provider    ElectricityProvider @relation(fields: [providerId], references: [id], onDelete: Restrict)

  @@index([meterNumber])
  @@map("electricity_transactions")
}

model CableTransaction {
  id              String   @id @default(uuid()) @db.Uuid
  transactionId   String   @unique @map("transaction_id") @db.Uuid
  providerId      String   @map("provider_id") @db.Uuid
  smartcardNumber String   @map("smartcard_number") @db.VarChar(50)
  customerName    String   @map("customer_name") @db.VarChar(255)
  packageCode     String   @map("package_code") @db.VarChar(50)
  packageName     String   @map("package_name") @db.VarChar(100)
  amountKobo      BigInt   @map("amount_kobo")
  renewalMonths   Int      @default(1) @map("renewal_months")
  createdAt       DateTime @default(now()) @map("created_at")

  transaction Transaction   @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  provider    CableProvider @relation(fields: [providerId], references: [id], onDelete: Restrict)

  @@index([smartcardNumber])
  @@map("cable_transactions")
}

// -------------------------------------------------------------
// CATALOG & PROVIDER MASTER DATA
// -------------------------------------------------------------

model Network {
  id                 String             @id @default(uuid()) @db.Uuid
  code               TelecomNetworkCode @unique
  name               String             @db.VarChar(50)
  airtimeDiscountBps Int                @default(200) @map("airtime_discount_bps") // 200 = 2.00%
  isActive           Boolean            @default(true) @map("is_active")
  airtimeEnabled     Boolean            @default(true) @map("airtime_enabled")
  dataEnabled        Boolean            @default(true) @map("data_enabled")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  dataPlans           DataPlan[]
  airtimeTransactions AirtimeTransaction[]
  dataTransactions    DataTransaction[]

  @@map("networks")
}

model DataPlan {
  id               String       @id @default(uuid()) @db.Uuid
  networkId        String       @map("network_id") @db.Uuid
  planCode         String       @map("plan_code") @db.VarChar(50)
  name             String       @db.VarChar(100)
  type             DataPlanType @default(SME)
  validity         String       @db.VarChar(50)
  costPriceKobo    BigInt       @map("cost_price_kobo")
  sellingPriceKobo BigInt       @map("selling_price_kobo")
  isActive         Boolean      @default(true) @map("is_active")
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")

  network          Network           @relation(fields: [networkId], references: [id], onDelete: Restrict)
  dataTransactions DataTransaction[]

  @@unique([networkId, planCode])
  @@index([networkId, isActive])
  @@map("data_plans")
}

model ElectricityProvider {
  id                 String   @id @default(uuid()) @db.Uuid
  code               String   @unique @db.VarChar(50)
  name               String   @db.VarChar(100)
  convenienceFeeKobo BigInt   @default(10000) @map("convenience_fee_kobo") // ₦100 default
  isActive           Boolean  @default(true) @map("is_active")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  electricityTransactions ElectricityTransaction[]

  @@map("electricity_providers")
}

model CableProvider {
  id                 String   @id @default(uuid()) @db.Uuid
  code               String   @unique @db.VarChar(50)
  name               String   @db.VarChar(100)
  convenienceFeeKobo BigInt   @default(10000) @map("convenience_fee_kobo") // ₦100 default
  isActive           Boolean  @default(true) @map("is_active")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  cableTransactions CableTransaction[]

  @@map("cable_providers")
}

// -------------------------------------------------------------
// REFERRALS & REWARDS
// -------------------------------------------------------------

model Referral {
  id             String         @id @default(uuid()) @db.Uuid
  referrerId     String         @map("referrer_id") @db.Uuid
  referredUserId String         @unique @map("referred_user_id") @db.Uuid
  status         ReferralStatus @default(PENDING_QUALIFICATION)
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  referrer     User             @relation("ReferrerRelation", fields: [referrerId], references: [id], onDelete: Restrict)
  referredUser User             @relation("ReferredUserRelation", fields: [referredUserId], references: [id], onDelete: Restrict)
  rewards      ReferralReward[]

  @@index([referrerId])
  @@map("referrals")
}

model ReferralReward {
  id            String    @id @default(uuid()) @db.Uuid
  referralId    String    @map("referral_id") @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  amountKobo    BigInt    @map("amount_kobo")
  isPaid        Boolean   @default(false) @map("is_paid")
  paidAt        DateTime? @map("paid_at")
  transactionId String?   @map("transaction_id") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at")

  referral    Referral     @relation(fields: [referralId], references: [id], onDelete: Restrict)
  user        User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  transaction Transaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  @@index([userId, isPaid])
  @@map("referral_rewards")
}

// -------------------------------------------------------------
// NOTIFICATIONS & SUPPORT
// -------------------------------------------------------------

model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  title     String           @db.VarChar(255)
  message   String           @db.Text
  type      NotificationType @default(TRANSACTION)
  isRead    Boolean          @default(false) @map("is_read")
  metadata  Json?
  createdAt DateTime         @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@map("notifications")
}

model SupportTicket {
  id            String         @id @default(uuid()) @db.Uuid
  userId        String         @map("user_id") @db.Uuid
  ticketNumber  String         @unique @map("ticket_number") @db.VarChar(50)
  subject       String         @db.VarChar(255)
  category      TicketCategory @default(GENERAL)
  status        TicketStatus   @default(OPEN)
  priority      TicketPriority @default(MEDIUM)
  transactionId String?        @map("transaction_id") @db.Uuid
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  user        User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  transaction Transaction?     @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  messages    SupportMessage[]

  @@index([userId, status])
  @@map("support_tickets")
}

model SupportMessage {
  id          String     @id @default(uuid()) @db.Uuid
  ticketId    String     @map("ticket_id") @db.Uuid
  senderId    String     @map("sender_id") @db.Uuid
  senderType  SenderType @map("sender_type")
  message     String     @db.Text
  attachments Json?
  createdAt   DateTime   @default(now()) @map("created_at")

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
  @@map("support_messages")
}

// -------------------------------------------------------------
// REFUNDS, AUDIT LOGS & SYSTEM
// -------------------------------------------------------------

model Refund {
  id            String       @id @default(uuid()) @db.Uuid
  transactionId String       @unique @map("transaction_id") @db.Uuid
  userId        String       @map("user_id") @db.Uuid
  amountKobo    BigInt       @map("amount_kobo")
  reason        String       @db.Text
  status        RefundStatus @default(PENDING)
  processedBy   String?      @map("processed_by") @db.Uuid
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  user        User        @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@map("refunds")
}

model AdminUser {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique @db.VarChar(255)
  fullName     String    @map("full_name") @db.VarChar(255)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  role         UserRole  @default(SUPPORT)
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@map("admin_users")
}

model AuditLog {
  id           String    @id @default(uuid()) @db.Uuid
  actorId      String    @map("actor_id") @db.Uuid
  actorType    ActorType @map("actor_type")
  action       String    @db.VarChar(100)
  targetEntity String    @map("target_entity") @db.VarChar(100)
  targetId     String?   @map("target_id") @db.VarChar(100)
  oldValues    Json?     @map("old_values")
  newValues    Json?     @map("new_values")
  ipAddress    String?   @map("ip_address") @db.VarChar(45)
  userAgent    String?   @map("user_agent") @db.VarChar(512)
  createdAt    DateTime  @default(now()) @map("created_at")

  @@index([actorId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

model ProviderTransaction {
  id                String   @id @default(uuid()) @db.Uuid
  transactionId     String   @map("transaction_id") @db.Uuid
  providerName      String   @map("provider_name") @db.VarChar(50)
  requestPayload    Json     @map("request_payload")
  responsePayload   Json     @map("response_payload")
  providerReference String?  @map("provider_reference") @db.VarChar(128)
  statusCode        Int?     @map("status_code")
  latencyMs         Int?     @map("latency_ms")
  createdAt         DateTime @default(now()) @map("created_at")

  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@index([transactionId])
  @@index([providerReference])
  @@map("provider_transactions")
}

model SystemSetting {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique @db.VarChar(100)
  value       String   @db.Text
  description String?  @db.VarChar(255)
  isSecret    Boolean  @default(false) @map("is_secret")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("system_settings")
}
